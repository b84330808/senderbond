# 複製成 .env 再填值。.env 已列入 .gitignore，絕對不要 commit。

# AI 主力：Groq（https://console.groq.com/keys）
GROQ_API_KEY=
GROQ_MODEL=

# AI 備援：Gemini（https://aistudio.google.com/api-keys，用沒綁付款的 Free tier 專案）
GEMINI_API_KEY=
GEMINI_MODEL=

# PayPal sandbox（developer.paypal.com → Apps & Credentials，切到 Sandbox）
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
