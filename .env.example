# Copy to .env and fill in. .env is git-ignored: never commit real keys.

# AI, primary: Groq (https://console.groq.com/keys, free plan)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# AI, fallback: Google Gemini (https://aistudio.google.com/api-keys, free tier, no billing)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# PayPal sandbox (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: ID of a webhook pointing at <your-host>/api/paypal/webhook
PAYPAL_WEBHOOK_ID=

# Optional: where the SQLite file lives (default ./data)
# DATA_DIR=
# Optional, build time: serve under a path prefix, e.g. /senderbond
# NEXT_PUBLIC_BASE_PATH=
